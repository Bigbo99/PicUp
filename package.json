{
  "name": "picup",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "pnpm --filter @picup/shared build && pnpm --filter @picup/api db:generate",
    "dev": "node scripts/dev-local.mjs",
    "dev:local": "node scripts/dev-local.mjs",
    "build": "pnpm --filter @picup/shared build && pnpm --filter @picup/api build && pnpm --filter @picup/web build",
    "start:web": "pnpm --filter @picup/web start",
    "start:api": "pnpm --filter @picup/api start",
    "start:worker": "pnpm --filter @picup/api start:worker",
    "lint": "pnpm exec eslint .",
    "lint:packages": "pnpm --filter @picup/web lint && pnpm --filter @picup/api lint",
    "test": "pnpm --filter @picup/api test",
    "typecheck": "pnpm --filter @picup/shared build && pnpm --filter @picup/api typecheck && pnpm --filter @picup/web typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^9.1.2",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.70.0"
  },
  "packageManager": "pnpm@10.30.0"
}
