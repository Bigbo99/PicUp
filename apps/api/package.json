{
  "name": "@picup/api",
  "version": "0.1.0",
  "private": true,
  "files": [
    "dist",
    "prisma"
  ],
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "dev:worker": "tsx watch src/workers/image-worker.ts",
    "build": "prisma generate --schema prisma/schema.prisma && tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "start:worker": "node dist/workers/image-worker.js",
    "smtp:test": "tsx src/tools/test-smtp.ts",
    "admin:promote": "tsx src/tools/promote-admin.ts",
    "guests:prune": "tsx src/tools/prune-guests.ts",
    "models:preview": "tsx src/tools/preview-models.ts",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "node scripts/run-tests.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@picup/shared": "workspace:*",
    "@prisma/client": "^6.19.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^8.0.7",
    "prisma": "^6.19.0",
    "redis": "^5.8.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.34.5",
    "undici": "^7.16.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.7",
    "@types/nodemailer": "^8.0.0",
    "tsx": "^4.19.2"
  }
}
