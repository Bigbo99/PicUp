APP_ENV=production
APP_VERSION=0.1.0
APP_IMAGE=crpi-dcv2ij8qo3puovop.cn-hangzhou.personal.cr.aliyuncs.com/dani_repo/picup:latest

WEB_PORT=3000
WEB_PUBLISH_PORT=127.0.0.1:3000
API_PORT=4000
API_PUBLISH_PORT=127.0.0.1:4000
API_HOST=0.0.0.0
# 必须留空！前端使用相对路径，由 Nginx 统一反代分流
NEXT_PUBLIC_API_BASE_URL=
WEB_PUBLIC_URL=https://your-domain.example
API_PUBLIC_URL=https://your-domain.example

POSTGRES_USER=picup
POSTGRES_PASSWORD=replace_with_strong_password
POSTGRES_DB=picup
POSTGRES_PORT=5432
POSTGRES_PUBLISH_PORT=127.0.0.1:15432
DATABASE_URL=postgresql://picup:replace_with_strong_password@postgres:5432/picup?schema=public
REDIS_PORT=6379
REDIS_PUBLISH_PORT=127.0.0.1:16379
REDIS_URL=redis://redis:6379
REDIS_QUEUE_PREFIX=picup:image-jobs

STORAGE_DIR=./storage
MEDIA_PUBLIC_BASE_URL=/media
# local keeps files under STORAGE_DIR. qiniu uploads inputs/outputs to Kodo and
# serves returned URLs through QINIU_PUBLIC_BASE_URL, usually a CDN domain.
STORAGE_DRIVER=local
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_BUCKET=picup-mendao
QINIU_REGION=cn-east-1
QINIU_S3_ENDPOINT=https://picup-mendao.s3.cn-east-1.qiniucs.com
QINIU_PUBLIC_BASE_URL=https://picup-media.ai-mendao.xyz
QINIU_TIMEOUT_MS=120000
QINIU_RETRY_ATTEMPTS=3
QINIU_PROXY_URL=

# AI providers, API keys, models, routes and request paths live in this JSON file.
AI_CONFIG_PATH=./config/ai-config.json

HTTPS_PROXY=
HTTP_PROXY=

JWT_SECRET=replace_with_random_secret
COOKIE_SECRET=replace_with_random_secret
ADMIN_EMAILS=1315410762@qq.com

EMAIL_DELIVERY_WEBHOOK_URL=
EMAIL_DELIVERY_WEBHOOK_SECRET=
SMTP_HOST=smtp.163.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_AUTH_METHOD=
SMTP_REJECT_UNAUTHORIZED=true
SMTP_CONNECTION_TIMEOUT_MS=30000
SMTP_GREETING_TIMEOUT_MS=30000
SMTP_SOCKET_TIMEOUT_MS=60000

WECHAT_SCAN_URL_TEMPLATE=
WECHAT_SCAN_BASE_URL=
WECHAT_AUTH_CALLBACK_SECRET=
