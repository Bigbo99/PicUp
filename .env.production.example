APP_ENV=production
APP_VERSION=0.1.0
APP_IMAGE=picup-app:local

WEB_PORT=3000
WEB_PUBLISH_PORT=127.0.0.1:3000
API_PORT=4000
API_PUBLISH_PORT=127.0.0.1:4000
API_HOST=0.0.0.0
# 必须留空！前端使用相对路径，由 Nginx 统一反代分流
NEXT_PUBLIC_API_BASE_URL=
WEB_PUBLIC_URL=https://your-domain.example
API_PUBLIC_URL=https://your-domain.example

POSTGRES_USER=picup
POSTGRES_PASSWORD=replace_with_strong_password
POSTGRES_DB=picup
POSTGRES_PORT=5432
POSTGRES_PUBLISH_PORT=127.0.0.1:15432
DATABASE_URL=postgresql://picup:replace_with_strong_password@postgres:5432/picup?schema=public
REDIS_PORT=6379
REDIS_PUBLISH_PORT=127.0.0.1:16379
REDIS_URL=redis://redis:6379
REDIS_QUEUE_PREFIX=picup:image-jobs

STORAGE_DIR=./storage
MEDIA_PUBLIC_BASE_URL=/media

PROVIDER_MOCK_ENABLED=true
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_REQUEST_TIMEOUT_MS=600000
GEMINI_RETRY_ATTEMPTS=3
GEMINI_RETRY_DELAY_MS=1500
GEMINI_PROXY_URL=
GEMINI_DISABLE_PROXY=false
GRSAI_API_KEY=
GRSAI_BASE_URL=

HTTPS_PROXY=
HTTP_PROXY=

JWT_SECRET=replace_with_random_secret
COOKIE_SECRET=replace_with_random_secret
ADMIN_EMAILS=1315410762@qq.com

EMAIL_DELIVERY_WEBHOOK_URL=
EMAIL_DELIVERY_WEBHOOK_SECRET=
SMTP_HOST=smtp.163.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_AUTH_METHOD=
SMTP_REJECT_UNAUTHORIZED=true
SMTP_CONNECTION_TIMEOUT_MS=30000
SMTP_GREETING_TIMEOUT_MS=30000
SMTP_SOCKET_TIMEOUT_MS=60000

WECHAT_SCAN_URL_TEMPLATE=
WECHAT_SCAN_BASE_URL=
WECHAT_AUTH_CALLBACK_SECRET=
