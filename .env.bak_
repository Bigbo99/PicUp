APP_ENV=production
APP_VERSION=0.1.0
APP_IMAGE=registry.example.com/picup-app:${APP_VERSION}

API_HOST=0.0.0.0
NEXT_PUBLIC_API_BASE_URL=https://picup.ai-mendao.xyz
API_PUBLIC_URL=https://picup.ai-mendao.xyz


RT=127.0.0.1:3000
POSTGRES_USER=picup
POSTGRES_PASSWORD=picup_password
POSTGRES_DB=picup
DATABASE_URL=postgresql://picup:picup_password@postgres:5432/picup?schema=public
REDIS_URL=redis://redis:6379
REDIS_QUEUE_PREFIX=picup:image-jobs

STORAGE_DIR=./storage
MEDIA_PUBLIC_BASE_URL=https://picup.ai-mendao.xyz/media

PROVIDER_MOCK_ENABLED=true
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
# Long image generations can take several minutes before response headers arrive.
GEMINI_REQUEST_TIMEOUT_MS=600000
GEMINI_RETRY_ATTEMPTS=3
GEMINI_RETRY_DELAY_MS=1500
# Optional. Overrides HTTPS_PROXY/HTTP_PROXY only for Gemini requests.
GEMINI_PROXY_URL=
# Set true to force Gemini requests to ignore proxy variables.
GEMINI_DISABLE_PROXY=false
GRSAI_API_KEY=
GRSAI_BASE_URL=

# Optional. Node fetch does not automatically use the Windows system proxy.
# Example: HTTPS_PROXY=http://127.0.0.1:7890
HTTPS_PROXY=
HTTP_PROXY=

JWT_SECRET=change-me
COOKIE_SECRET=change-me
ADMIN_EMAILS=

# Optional email-code delivery webhook. If empty in development, /api/auth/email/start
# returns a devCode so the flow can be tested without an email provider.
EMAIL_DELIVERY_WEBHOOK_URL=
EMAIL_DELIVERY_WEBHOOK_SECRET=

# WeChat scan login middleware integration.
# Template supports {state} and {callbackUrl}, for example:
# https://your-middleware.example.com/wechat/qr?state={state}&callback={callbackUrl}
WECHAT_SCAN_URL_TEMPLATE=
WECHAT_SCAN_BASE_URL=
WECHAT_AUTH_CALLBACK_SECRET=
WEB_PORT=3000
WEB_PUBLISH_PORT=127.0.0.1:3000
API_PORT=4000
API_PUBLISH_PORT=127.0.0.1:4000
POSTGRES_PORT=5432
POSTGRES_PUBLISH_PORT=127.0.0.1:15432
REDIS_PORT=6379
REDIS_PUBLISH_PORT=127.0.0.1:16379
WEB_PUBLIC_URL=https://picup.ai-mendao.xyz
API_CORS_ORIGINS=https://picup.ai-mendao.xyz
