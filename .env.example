APP_ENV=development
APP_VERSION=0.1.0
APP_IMAGE=registry.example.com/picup-app:${APP_VERSION}

WEB_PORT=3000
WEB_PUBLISH_PORT=3000
API_PORT=4000
API_PUBLISH_PORT=4000
API_HOST=0.0.0.0
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
WEB_PUBLIC_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000

POSTGRES_USER=picup
POSTGRES_PASSWORD=picup_password
POSTGRES_DB=picup
POSTGRES_PORT=5432
POSTGRES_PUBLISH_PORT=5432
DATABASE_URL=postgresql://picup:picup_password@postgres:5432/picup?schema=public
REDIS_PORT=6379
REDIS_PUBLISH_PORT=6379
REDIS_URL=redis://redis:6379
REDIS_QUEUE_PREFIX=picup:image-jobs

STORAGE_DIR=./storage
MEDIA_PUBLIC_BASE_URL=http://localhost:4000/media

PROVIDER_MOCK_ENABLED=true
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
# Long image generations can take several minutes before response headers arrive.
GEMINI_REQUEST_TIMEOUT_MS=600000
GEMINI_RETRY_ATTEMPTS=3
GEMINI_RETRY_DELAY_MS=1500
# Optional. Overrides HTTPS_PROXY/HTTP_PROXY only for Gemini requests.
GEMINI_PROXY_URL=
# Set true to force Gemini requests to ignore proxy variables.
GEMINI_DISABLE_PROXY=false
GRSAI_API_KEY=
GRSAI_BASE_URL=

# Optional. Node fetch does not automatically use the Windows system proxy.
# Example: HTTPS_PROXY=http://127.0.0.1:7890
HTTPS_PROXY=
HTTP_PROXY=

JWT_SECRET=change-me
COOKIE_SECRET=change-me
ADMIN_EMAILS=1315410762@qq.com

# Optional email-code delivery webhook. If empty in development, /api/auth/email/start
# returns a devCode so the flow can be tested without an email provider.
EMAIL_DELIVERY_WEBHOOK_URL=
EMAIL_DELIVERY_WEBHOOK_SECRET=

# Optional SMTP email-code delivery. SMTP takes priority over the webhook when configured.
# For 163 mail with port 587, use SMTP_SECURE=false and SMTP_REQUIRE_TLS=true.
SMTP_HOST=smtp.163.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
# Optional. Set to LOGIN only if your SMTP provider requires AUTH LOGIN.
SMTP_AUTH_METHOD=
SMTP_REJECT_UNAUTHORIZED=true
SMTP_CONNECTION_TIMEOUT_MS=30000
SMTP_GREETING_TIMEOUT_MS=30000
SMTP_SOCKET_TIMEOUT_MS=60000

# WeChat scan login middleware integration.
# Template supports {state} and {callbackUrl}, for example:
# https://your-middleware.example.com/wechat/qr?state={state}&callback={callbackUrl}
WECHAT_SCAN_URL_TEMPLATE=
WECHAT_SCAN_BASE_URL=
WECHAT_AUTH_CALLBACK_SECRET=
WXMID_URL=
WXMID_KEY=
WXMID_APP_CODE=
